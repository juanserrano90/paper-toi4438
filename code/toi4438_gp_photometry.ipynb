    "def mass_radius(R):\n",
    "    M_minus = (R/0.53)**(1/0.62)\n",
    "    M_plus = (R/0.59)**(1/0.72)\n",
    "    return (M_plus + M_minus)/2, (M_minus-M_plus)/2\n",
    "\n",
    "def radius_mass(M):\n",
    "    R_minus = 0.53 * M**0.62\n",
    "    R_plus = 0.59 * M**0.72\n",
    "    return (R_plus + R_minus)/2, (R_plus - R_minus)/2\n",
    "\n",
    "def transit_depth(r_pl, r_star):\n",
    "    return (r_pl/r_star)**2 * 1e3  # in ppt"
   ]
