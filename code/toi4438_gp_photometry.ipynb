   "source": [
    "# binning\n",
    "bins = np.linspace(-4.1, 4.1, 20)  # hours\n",
    "phase_hours = folded_lc[ins] * 24\n",
    "\n",
    "bin_center = 0.5 * (bins[1:] + bins[:-1])\n",
    "bin_flux = np.zeros(len(bin_center))\n",
    "bin_err = np.zeros(len(bin_center))\n",
    "\n",
    "for i in range(len(bin_center)):\n",
    "    m = (phase_hours >= bins[i]) & (phase_hours < bins[i+1])\n",
    "    \n",
    "    if np.sum(m) > 0:\n",
    "        w = 1 / yerr_[ins][m]**2\n",
    "        bin_flux[i] = np.sum(y_[ins][m] * w) / np.sum(w)\n",
    "        bin_err[i] = np.sqrt(1 / np.sum(w))\n",
    "    else:\n",
    "        bin_flux[i] = np.nan\n",
    "        bin_err[i] = np.nan\n",
    "\n",
    "res = y_[ins] - lc_model[1][ins]\n",
    "\n",
    "bin_res = np.zeros(len(bin_center))\n",
    "bin_res_err = np.zeros(len(bin_center))\n",
    "\n",
    "for i in range(len(bin_center)):\n",
    "    m = (phase_hours >= bins[i]) & (phase_hours < bins[i+1])\n",
    "    \n",
    "    if np.sum(m) > 0:\n",
    "        w = 1 / yerr_[ins][m]**2\n",
    "        bin_res[i] = np.sum(res[m] * w) / np.sum(w)\n",
