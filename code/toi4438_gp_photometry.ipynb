   "source": [
    "t_ = np.ascontiguousarray(x_c + np.min(time), dtype=np.float64)\n",
    "y_ = np.ascontiguousarray(y_c, dtype=np.float64)\n",
    "yerr_ = np.ascontiguousarray(yerr_c, dtype=np.float64)\n",
    "\n",
    "new_mask = (t_ < 3473) & (t_ > 3470)\n",
    "t_ = t_[new_mask]\n",
    "y_ = y_[new_mask]\n",
    "yerr_ = yerr_[new_mask]\n",
    "\n",
    "plt.errorbar(t_, y_, yerr=yerr_, fmt='o', color='black', markersize=1, elinewidth=0.3, alpha=0.5, label='Data')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 55,
   "metadata": {},
   "outputs": [],
   "source": [
    "# sort data (important for binning)\n",
    "inds = np.argsort(t_)\n",
    "t = t_[inds]\n",
    "y = y_[inds]\n",
    "yerr = yerr_[inds]\n",
    "\n",
    "# define bins\n",
    "nbins = 60\n",
    "bins = np.linspace(t.min(), t.max(), nbins+1)\n",
    "\n",
    "bin_center = 0.5 * (bins[1:] + bins[:-1])\n",
    "bin_flux = np.zeros(nbins)\n",
    "bin_err = np.zeros(nbins)\n",
    "\n",
    "for i in range(nbins):\n",
    "    m = (t >= bins[i]) & (t < bins[i+1])\n",
    "    \n",
    "    if np.sum(m) > 0:\n",
    "        w = 1 / yerr[m]**2\n",
    "        bin_flux[i] = np.sum(y[m] * w) / np.sum(w)\n",
    "        bin_err[i] = np.sqrt(1 / np.sum(w))\n",
    "    else:\n",
    "        bin_flux[i] = np.nan\n",
    "        bin_err[i] = np.nan"
   ]
  },
