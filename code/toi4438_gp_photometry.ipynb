   "source": [
    "import astropy.constants as const\n",
    "\n",
    "P_min = 32.7 # your baseline lower limit (days)\n",
    "texp = 0.001388888888888889\n",
    "phase_lc = np.linspace(-0.3, 0.3, 500)\n",
    "\n",
    "with pm.Model() as model_single_transit:\n",
    "    # Stellar density prior (from M and R)\n",
    "    m_star = pm.Normal(\"m_star\", mu=mstar.value, sigma=mstar.minus)  \n",
    "    r_star = pm.Normal(\"r_star\", mu=rstar.value, sigma=rstar.minus)  \n",
    "\n",
    "    rho_sun = 1.408 # g/cm^3\n",
    "    rho_star = rho_sun * m_star / r_star**3 \n",
    "    pm.Deterministic('rho_star', rho_star)\n",
    "\n",
    "    # Period prior (must be > baseline constraint)\n",
    "    logP = pm.Uniform(\"logP\", np.log(P_min), np.log(2000))\n",
    "    period = pm.Deterministic(\"period\", pt.exp(logP))\n",
    "\n",
    "    # Transit parameters\n",
    "    t0 = pm.Normal(\"t0\", mu=3471.5591, sigma=0.1)\n",
    "\n",
    "    b = pm.Uniform(\"b\", 0, 1)\n",
    "\n",
    "    # a/R* from stellar density + period (kepler's third law)\n",
    "    a_R = ((const.G.value * rho_star * 1000 / (3*np.pi))**(1/3) * (period*86400)**(2/3))\n",
    "    a_R = pm.Deterministic(\"a_R\", a_R)\n",
    "    ror = pm.Normal(\"ror\", mu=0.045, sigma=0.0032)\n",
    "\n",
    "    # Eq. 3.4 - Transiting Exoplanets 2\n",
    "    t_dur = pm.Deterministic(\"t_dur\", period / np.pi * pt.arcsin(pt.sqrt((1 + ror)**2 - b**2) / a_R))\n",
    "\n",
    "    # orbit\n",
    "    orbit = xo.orbits.KeplerianOrbit(\n",
    "        period=period,\n",
    "        t0=t0,\n",
    "        b=b,\n",
    "        duration=t_dur,\n",
    "        ror=ror\n",
    "    )\n",
    "\n",
    "    r_pl = pm.Deterministic(\"r_pl\", ror * r_star * u.R_sun.to(u.R_earth))\n",
    "\n",
    "    a = orbit.a\n",
    "    pm.Deterministic('a', a*u.m.to(u.au))\n",
    "    teq = pm.Deterministic('teq', par.iloc[1].teff*(r_star*u.R_sun.to(u.au)/a)**(1/2)*(1/4)**(1/4))\n",
    "\n",
    "    q1 = 0.234771 \n",
    "    q2 = 0.332183 \n",
    "    sqrtq1 = np.sqrt(q1)\n",
    "    twoq2 = 2 * q2\n",
    "    u_star = [sqrtq1 * twoq2, sqrtq1 * (1 - twoq2)]\n",
    "    star = xo.LimbDarkLightCurve(u1=u_star[0], u2=u_star[1])\n",
    "\n",
    "    def lc_model(orbit, mean_, star, ror, texp_, t_):\n",
    "        return pt.sum(1e3*star.get_light_curve(orbit=orbit, r=ror, t=t_, texp=texp_), axis=-1) + mean_\n",
    "\n",
    "    lc_mean = pm.Normal(\"lc_mean\", mu=0.0, sigma=1.0) \n",
    "    logs = pm.Normal(\"logs\", mu=np.log(np.std(y_)), sigma=1) \n",
    "    err_lc = pt.sqrt(yerr_**2 + pt.exp(2 * logs)) \n",
    "\n",
    "    lc_mod = lc_model(orbit, lc_mean, star, ror, texp, t_)\n",
    "    pm.Deterministic(\"lc_mod\", lc_mod)\n",
    "\n",
    "    lc_phase_mod = lc_model(orbit, lc_mean, star, ror, texp, t0 + phase_lc)\n",
    "    pm.Deterministic(\"lc_phase\", lc_phase_mod)\n",
    "\n",
    "    pm.Normal(\"lc_obs\", mu=lc_mod, sigma=err_lc, observed=y_) \n",
    "    \n",
    "    map_soln_tess = pm.find_MAP()"
   ]
  },
