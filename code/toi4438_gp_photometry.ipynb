    "import numpy as np\n",
    "\n",
    "def minimum_period_single_transit(t_obs, t_transit, duration,\n",
    "                                  P_min=0.5, P_max=200, n_periods=50000):\n",
    "    \"\"\"\n",
    "    Compute the minimum allowed orbital period from a single detected transit.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    t_obs : array\n",
    "        Times of photometric observations (e.g. TESS timestamps).\n",
    "    t_transit : float\n",
    "        Mid-transit time of the detected event.\n",
    "    duration : float\n",
    "        Transit duration (same units as times).\n",
    "    P_min : float\n",
    "        Minimum trial period to test.\n",
    "    P_max : float\n",
    "        Maximum trial period to test.\n",
    "    n_periods : int\n",
    "        Number of periods to sample between P_min and P_max.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    P_allowed : array\n",
    "        Periods that are consistent with observing only one transit.\n",
    "    P_lower_limit : float\n",
    "        Smallest allowed orbital period.\n",
    "    \"\"\"\n",
    "\n",
    "    # Create grid of trial periods\n",
    "    periods = np.linspace(P_min, P_max, n_periods)\n",
    "\n",
    "    # Sort observation times for safety\n",
    "    t_obs = np.sort(t_obs)\n",
    "\n",
    "    allowed_periods = []\n",
    "\n",
    "    for P in periods:\n",
    "\n",
    "        # Generate possible transit epochs near the data span\n",
    "        n_min = int((t_obs[0] - t_transit) / P) - 1\n",
    "        n_max = int((t_obs[-1] - t_transit) / P) + 1\n",
    "\n",
    "        transit_times = t_transit + np.arange(n_min, n_max+1) * P\n",
    "\n",
    "        valid = True\n",
    "\n",
    "        for t in transit_times:\n",
    "\n",
    "            # Skip the actual detected transit\n",
    "            if abs(t - t_transit) < duration:\n",
    "                continue\n",
    "\n",
    "            # Check if a predicted transit overlaps observations\n",
    "            if np.any(np.abs(t_obs - t) < duration/2):\n",
    "                valid = False\n",
    "                break\n",
    "\n",
    "        if valid:\n",
    "            allowed_periods.append(P)\n",
    "\n",
    "    allowed_periods = np.array(allowed_periods)\n",
    "\n",
    "    if len(allowed_periods) == 0:\n",
    "        return allowed_periods, None\n",
    "\n",
    "    return allowed_periods, np.min(allowed_periods)"
   ]
  },
