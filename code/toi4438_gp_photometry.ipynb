    "import numpy as np\n",
    "import astropy.units as u\n",
    "import astropy.constants as const\n",
    "\n",
    "def rv_semi_amplitude(mp, mstar, period):\n",
    "    \"\"\"\n",
    "    Compute RV semi-amplitude K.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    mp : quantity\n",
    "        Planet mass (e.g. 5*u.M_earth)\n",
    "    mstar : quantity\n",
    "        Stellar mass (e.g. 0.35*u.M_sun)\n",
    "    period : quantity\n",
    "        Orbital period (e.g. 69*u.day)\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    K : quantity\n",
    "        RV semi-amplitude in m/s\n",
    "    \"\"\"\n",
    "\n",
    "    K = (mp / (mp + mstar)**(2/3)) * ((period / (2*np.pi*const.G))**(-1/3))\n",
    "\n",
    "    return K.to(u.m/u.s)"
   ]
  },
